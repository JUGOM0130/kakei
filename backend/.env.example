# 本番 (config.settings.prod) 用の環境変数。/opt/kakei/backend/.env に置き chmod 600。
# SECRET_KEY の生成: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=kakei.example.jp
CSRF_TRUSTED_ORIGINS=https://kakei.example.jp
SQLITE_PATH=/opt/kakei/backend/data/db.sqlite3
STATIC_ROOT=/opt/kakei/backend/staticfiles
