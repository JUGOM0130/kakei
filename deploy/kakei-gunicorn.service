[Unit]
Description=kakei gunicorn
After=network.target

[Service]
User=kakei
Group=kakei
WorkingDirectory=/opt/kakei/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
# サブパス /kakei/ で公開するため。gunicorn が PATH_INFO から剥がし、
# Django の reverse()/リダイレクト/STATIC_URL に自動で前置される
Environment=SCRIPT_NAME=/kakei
EnvironmentFile=/opt/kakei/backend/.env
# AlmaLinux (SELinux) では unix ソケットより 127.0.0.1 TCP の方が扱いやすい。
# 8001 はこの VPS の既存アプリが使用中のため 8011 を使う
# timeout は OCR 取込 (画像PDF) を考慮して長め
ExecStart=/opt/kakei/backend/.venv/bin/gunicorn config.wsgi:application \
  --workers 2 --bind 127.0.0.1:8011 --timeout 180
Restart=on-failure

[Install]
WantedBy=multi-user.target
